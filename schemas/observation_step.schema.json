{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "observation_step.schema.json",
  "title": "Observation after step",
  "description": "result: list_records -> {records, next_cursor}; get_record/get_document -> the object; calculator -> decimal string; submit -> {accepted: true}; null on error. error: null or {code, message <= 200 chars}, without paths, seed or closed data.",
  "type": "object",
  "required": ["result", "error", "remaining_steps"],
  "additionalProperties": false,
  "properties": {
    "result": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "common.schema.json#/$defs/decimal_string", "description": "calculator"},
        {"type": "string", "pattern": "^-[0-9]+(\\.[0-9]+)?$", "description": "negative calculator result"},
        {
          "type": "object", "required": ["records", "next_cursor"], "additionalProperties": false,
          "properties": {"records": {"type": "array", "maxItems": 50}, "next_cursor": {"type": ["string", "null"]}}
        },
        {"type": "object", "required": ["accepted"], "additionalProperties": false, "properties": {"accepted": {"const": true}}},
        {"$ref": "ledger_row.schema.json"},
        {"$ref": "invoice.schema.json"},
        {"$ref": "payment.schema.json"},
        {"$ref": "fx_row.schema.json"},
        {"$ref": "manifest.schema.json"},
        {"$ref": "policy.schema.json"}
      ]
    },
    "error": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object", "required": ["code", "message"], "additionalProperties": false,
          "properties": {
            "code": {"enum": ["invalid_action", "unknown_action", "invalid_arguments", "invalid_cursor", "not_found",
                              "calculator_error", "invalid_submission", "time_limit", "episode_finished"]},
            "message": {"type": "string", "maxLength": 200}
          }
        }
      ]
    },
    "remaining_steps": {"type": "integer", "minimum": 0, "maximum": 100}
  }
}
