{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "invoice.schema.json",
  "title": "invoices.jsonl line",
  "description": "Invoice document (table 'invoices', also get_document). line_items keep their order (line_no).",
  "type": "object",
  "required": ["doc_id", "invoice_id", "entity_id", "issued_at", "due_at", "currency", "total_minor", "line_items"],
  "additionalProperties": false,
  "properties": {
    "doc_id": {"$ref": "common.schema.json#/$defs/id"},
    "invoice_id": {"$ref": "common.schema.json#/$defs/id"},
    "entity_id": {"$ref": "common.schema.json#/$defs/id"},
    "issued_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "due_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "currency": {"$ref": "common.schema.json#/$defs/currency"},
    "total_minor": {"$ref": "common.schema.json#/$defs/minor_units"},
    "line_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["line_no", "description", "quantity", "unit_price_minor", "amount_minor"],
        "additionalProperties": false,
        "properties": {
          "line_no": {"type": "integer", "minimum": 1},
          "description": {"type": "string"},
          "quantity": {"type": "integer", "minimum": 1},
          "unit_price_minor": {"$ref": "common.schema.json#/$defs/minor_units"},
          "amount_minor": {"$ref": "common.schema.json#/$defs/minor_units"}
        }
      }
    }
  }
}
